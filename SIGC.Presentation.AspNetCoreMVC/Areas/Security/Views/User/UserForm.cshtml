@{
    Layout = null;
}
<form id="frmUserCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-8">
                <div class="row pb-2">
                    <label for="txtUserID" class="col-sm-2 col-form-label">ID</label>
                    <div class="col-sm-3">
                        <input type="text" class="form-control" id="txtUserID" readonly value="GENERADO" />
                    </div>
                    <label for="chkStateID" class="col-sm-2 col-form-label">Estado</label>
                    <div class="col-sm-5 pt-2">
                        <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                            <input type="checkbox" class="form-check-input" checked id="chkStateID">
                            <label class="form-check-label" for="chkStateID">Activo</label>
                        </div>
                    </div>
                </div>
                <div class="row pb-2">
                    <label for="txtUserLastName" class="col-sm-2 col-form-label">Apellidos<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtUserLastName" name="UserLastName" />
                    </div>
                    <label for="txtUserFirstName" class="col-sm-2 col-form-label">Nombres<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtUserFirstName" name="UserFirstName" />
                    </div>
                </div>        
                <div class="row pb-2">
                    <label for="txtUserName" class="col-sm-2 col-form-label">Usuario<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtUserName" name="UserName" />
                    </div>
                    <label for="txtUserPassword" class="col-sm-2 col-form-label">Contraseña<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtUserPassword" name="UserPassword" />
                    </div>
                </div> 
                <div class="row pb-2">
                    <label for="txtUserMail" class="col-sm-2 col-form-label">Correo<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="txtUserMail" name="UserMail" />
                    </div>
                </div>
                <div class="row pb-2">
                    <label class="col-sm-2 col-form-label">Roles<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-10" id="div-roles">
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border card-border-light">                  
                    <div class="card-body p-4">
                        <div class="text-center">
                            <h4>Foto</h4>
                            <div class="profile-user position-relative d-inline-block mx-auto  mb-4">
                                <input type="hidden" id="hdUserPhoto" name="UserPhoto" />
                                <input type="hidden" id="hdUserPhotoBandera" name="UserPhotoBandera" />
                                <img style="width:250px;height:250px" src="~/assets/images/image-not-available.jpg" class="rounded-circle img-thumbnail user-profile-image" id="imgUserPhoto" alt="user-profile-image">
                                <div class="avatar-xs p-0 rounded-circle profile-photo-edit">
                                    <input id="profile-img-file-input" type="file" class="profile-img-file-input">
                                    <label for="profile-img-file-input" class="profile-photo-edit avatar-xs">
                                        <span class="avatar-title rounded-circle bg-light text-body" style="border:solid 2px;border-color:green;">
                                            <i class="ri-camera-fill align-bottom fs-16 text-success"></i>
                                        </span>
                                        <button id="btnQuitar" type="button" class="avatar-title rounded-circle bg-light text-danger mt-1" style="border-color:red;"><i class="ri-delete-bin-5-fill fs-16 align-bottom fs-16"></i></button>
                                    </label>
                                </div>
                            </div>                                           
                        </div>
                    </div>
                </div>
            </div>
       </div>
        <div class="row">
            <div class="col-sm-8 pb-2 mt-3">               
                <div class="text-end">
                    <button type="button" class="btn btn-light" id="btnUserNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                    <button type="button" class="btn btn-primary" id="btnUserCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                    <button type="submit" class="btn btn-primary" id="btnUserUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                </div>
            </div>
        </div> 
    </div>
</form> 