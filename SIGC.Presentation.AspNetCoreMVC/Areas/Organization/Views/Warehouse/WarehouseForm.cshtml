@{
    Layout = null;
}
<form id="frmWarehouseCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row g-3">          
                <div class="row pb-2">
                    <label for="txtWarehouseID" class="col-sm-3 col-form-label">ID</label>
                    <div class="col-sm-3">
                        <input type="text" class="form-control" id="txtWarehouseID" name="WarehouseID" readonly value="GENERADO" />
                    </div>
                </div>
                <div class="row pb-2">
                    <label for="cboTypeID" class="col-sm-3 col-form-label">Tipo<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-3">                       
                        <select class="form-select" id="cboTypeID" name="TypeID">
                            <option value="">Seleccionar</option>
                            <option value="1">Interno</option>
                            <option value="2">Externo</option>                          
                        </select>
                    </div>
                    <label for="txtWarehouseCode" class="col-sm-1 col-form-label">Código<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-3">
                        <input type="text" class="form-control" id="txtWarehouseCode" name="WarehouseCode" maxlength="10" />
                    </div>
                </div> 
                <div class="row pb-2">
                    <label for="txtWarehouseName" class="col-sm-3 col-form-label">Nombre<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-7">
                        <input type="text" class="form-control" id="txtWarehouseName" name="WarehouseName" maxlength="100" />
                    </div>
                </div>
               @*
                <div class="row pb-2">
                    <label for="txtWarehouseAddress" class="col-sm-3 col-form-label">Dirección<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-7">
                        <textarea class="form-control" id="txtWarehouseAddress" name="WarehouseAddress" maxlength="150"></textarea>
                    </div>
                </div>
                *@
                <div class="row pb-2">
                    <label for="chkStateID" class="col-sm-3 col-form-label">Estado</label>
                    <div class="col-sm-4 pt-2">
                        <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                            <input type="checkbox" class="form-check-input" checked id="chkStateID">
                            <label class="form-check-label" for="chkStateID">Activo</label>
                        </div>
                    </div>
                </div>              
            <div class="row g-3">
               <div class="col-sm-10 mt-3">                
                  <div class="text-end">
                     <button type="button" class="btn btn-light" id="btnWarehouseNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                     <button type="button" class="btn btn-primary" id="btnWarehouseCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                     <button type="button" class="btn btn-primary" id="btnWarehouseUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                  </div>                
             </div>
           </div>
        </div>
    </div>
</form> 