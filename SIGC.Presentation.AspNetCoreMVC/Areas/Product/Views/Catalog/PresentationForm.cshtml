@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.UnitMeasure 
@{
    Layout = null;
}
<form id="frmCatalogVariantCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row pb-2">
            <label class="col-sm-1 col-form-label">Producto</label>
            <div class="col-sm-11">
                <input type="text" class="form-control" name="CatalogNameLabel" readonly />
            </div>
        </div>
        <div class="card" id="div-variant">
            <div class="card-header p-2" style="background:#f3f3f9">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h6 class="card-title mb-0">Variante:&nbsp;<span id="span-catalog-variant-name"></span></h6>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row pb-2">
                    <label for="txtCatalogVariantName" class="col-sm-2 col-form-label">Nombre<i class="ri-asterisk align-middle text-danger"></i></label>
                    <div class="col-sm-6 row">
                        <div class="col-sm-10">
                            <input type="hidden" id="hdCatalogVariantID" />
                            <input type="text" class="form-control" id="txtCatalogVariantName" name="CatalogVariantName" maxlength="100" placeholder="Único / Talla - Color, 32 - R" value="Único" />
                          </div>
                        <div class="col-sm-2">
                            <button class="btn btn-outline-success" type="button" id="btnAttributeSearchOpen"><i class="ri-search-2-line align-bottom me-1 fs-13"></i>Ver</button>
                        </div>                
                    </div>
                    <label for="txtCatalogVariantSKU" class="col-sm-1 col-form-label">SKU</label>
                    <div class="col-sm-3">
                        <input type="text" class="form-control" id="txtCatalogVariantSKU" name="CatalogVariantSKU" maxlength="50" />
                    </div>
                </div> 
                <div class="card mb-2" id="div-presentation">
                        <div class="card-header p-2" style="background:#f3f3f9">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="card-title mb-0">Presentación</h6>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row pb-2">
                            <input type="hidden" id="hdCatalogPresentationID" />
                                <label for="cboUnitMeasureID" class="col-sm-1 col-form-label">Medida<i class="ri-asterisk align-middle text-danger"></i></label>
                                <div class="col-sm-3">
                                <select class="form-select" id="cboUnitMeasureID" name="UnitMeasureID">
                                    @if (@ViewBag.UnitMeasureList != null)
                                        {
                                            <option value="">Seleccionar</option>
                                        var UnitMeasureList = ViewBag.UnitMeasureList as List<UnitMeasureListResponseModel>;
                                        @foreach (var Item in UnitMeasureList!)
                                            {
                                                <option value="@Item.UnitMeasureID">@Item.UnitMeasureName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            <label for="cboPresentationID" class="col-sm-2 col-form-label">Presentación<i class="ri-asterisk align-middle text-danger"></i></label>
                                <div class="col-sm-3">
                                <select class="form-select" id="cboPresentationID" name="PresentationID">
                                    <option value="">Seleccionar</option> 
                                    </select>
                                </div>
                            <label for="txtCatalogPresentationEquivalence" class="col-sm-1 col-form-label">Factor<i class="ri-asterisk align-middle text-danger"></i></label>
                                <div class="col-sm-2">
                                <input type="text" class="form-control" id="txtCatalogPresentationEquivalence" name="CatalogPresentationEquivalence" />
                                </div>
                            </div>
                            <div class="row pb-2">
                            <label for="txtCatalogPresentationSKU" class="col-sm-1 col-form-label">SKU</label>
                                <div class="col-sm-3">
                                <input type="text" class="form-control" id="txtCatalogPresentationSKU" name="CatalogPresentationSKU" />
                                </div>
                                <label for="txtCatalogPresentationBarcode" class="col-sm-1 col-form-label">COD.QR</label>
                                <div class="col-sm-3">
                                <input type="text" class="form-control" id="txtCatalogPresentationBarcode" name="CatalogPresentationBarcode" />
                                </div>
                               <label for="chkCatalogPresentationStateID" class="col-sm-1 col-form-label">Estado</label>
                                <div class="col-sm-2 pt-2">
                                    <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                                    <input type="checkbox" class="form-check-input" checked id="chkCatalogPresentationStateID">
                                    <label class="form-check-label" for="chkCatalogPresentationStateID">Activo</label>
                                    </div>
                                </div>
                            </div>                           
                        </div>
                    </div>                
                <div class="row pt-2">
                    <div class="col-sm-12">
                        <div class="text-end">
                            <button type="button" class="btn btn-light" id="btnCatalogVariantNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                            <button type="button" class="btn btn-primary" id="btnCatalogVariantCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                            <button type="button" class="btn btn-primary" id="btnCatalogPresentationCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                            <button type="button" class="btn btn-primary" id="btnCatalogVariantUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>  
    </div>
</form>
<partial name="Modal/AttributeSearch" />