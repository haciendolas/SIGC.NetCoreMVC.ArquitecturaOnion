@using SIGC.Presentation.AspNetCoreMVC.Areas.Security.Models.Constant
@{
    Layout = null;
}
<form id="frmCompanyCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row pb-2">
            <label for="txtCompanyCorporateEmail" class="col-sm-1 col-form-label">Producto<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-11">
                <input type="text" class="form-control" id="txtCompanyCorporateEmail" name="CompanyCorporateEmail" readonly />
            </div>
        </div>
        <div class="row pb-2">
            <label for="txtCompanyPhone" class="col-sm-1 col-form-label" style="padding-right:0px">Impuesto<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-3">
                <select class="form-select" id="cboTaxpayerTypeID" name="TaxpayerTypeID">
                    @if (@ViewBag.TaxpayerTypeList != null)
                    {
                        <option value="">Seleccionar</option>

                        var TaxpayerTypeList = ViewBag.TaxpayerTypeList as List<ConstantListResponseModel>;
                        @foreach (var Item in TaxpayerTypeList!)
                        {
                            <option value="@Item.ConstantID">@Item.ConstantName</option>
                        }
                    }
                </select>
            </div>
            <label for="cboTaxAffectationTypeID" class="col-sm-1 col-form-label">Afectación<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-3">
                <select class="form-select" id="cboTaxAffectationTypeID" name="TaxAffectationTypeID">
                    @if (@ViewBag.TaxAffectationTypeList != null)
                    {
                        <option value="">Seleccionar</option>
                        var TaxAffectationTypeList = ViewBag.TaxAffectationTypeList as List<ConstantListResponseModel>;
                        @foreach (var Item in TaxAffectationTypeList!)
                        {
                            <option value="@Item.ConstantID">@Item.ConstantName</option>
                        }
                    }
                </select>
            </div>
            <label for="chkStateID" class="col-sm-1 col-form-label">Estado</label>
            <div class="col-sm-2 pt-2">
                <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                    <input type="checkbox" class="form-check-input" checked id="chkStateID">
                    <label class="form-check-label" for="chkStateID">Activo</label>
                </div>
            </div>
        </div>
 
        <div class="row2">
            <div class="col-sm-12">
                <div class="text-end">
                    <button type="button" class="btn btn-light" id="btnCompanyNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                    <button type="button" class="btn btn-primary" id="btnCompanyCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                    <button type="button" class="btn btn-primary" id="btnCompanyUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                </div>
            </div>
        </div>
    </div>
</form>
<div class="card m-2 border-1">
    <div class="card-header p-2" style="background:#f3f3f9">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h6 class="card-title mb-0">LISTADO DE IMPUESTO</h6>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive table-card p-1">
            <table class="table align-middle" id="dtCompany">
                <thead class="table-light text-muted">
                    <tr>
                        <th class="text-center">ID.Impuesto</th>
                        <th class="text-center">Tipo Impuesto</th>
                        <th class="text-center">Tipo Calculo</th>
                        <th class="text-center">Tipo Dirección</th>
                        <th class="text-center">Tipo Afectación</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" colspan="2">Opciones</th>
                    </tr>
                </thead>
                <tbody id="details-list">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card m-2 border-1">
    <div class="card-header p-2" style="background:#f3f3f9">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h6 class="card-title mb-0">LISTADO DE IMPUESTO EXCLUIDOS</h6>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive table-card p-1">
            <table class="table align-middle" id="dtCompany">
                <thead class="table-light text-muted">
                    <tr>
                        <th class="text-center">Establecimiento</th>
                        <th class="text-center">ID.Excluido</th>
                        <th class="text-center">Tipo Impuesto</th>  
                        <th class="text-center">Estado</th>
                        <th class="text-center" colspan="2">Opciones</th>
                    </tr>
                </thead>
                <tbody id="details-list">
                </tbody>
            </table>
        </div>
    </div>
</div>