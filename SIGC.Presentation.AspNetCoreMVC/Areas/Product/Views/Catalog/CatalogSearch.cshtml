@{
    Layout = null;
}
@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.Brand
@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.CatalogType 
@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.Category
@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.Manufacturer
<div class="card-body border-bottom-dashed border-bottom">
    <form method="dialog">
        <div class="row pb-2">
            <label for="scbosCatalogTypeID" class="col-sm-1 col-form-label">Tipo</label>
            <div class="col-sm-2">
                <select class="form-select" id="scboCatalogTypeID">
                    @if (@ViewBag.CatalogTypeList != null)
                    {
                        <option>Todos</option>
                        var CatalogTypeList = ViewBag.CatalogTypeList as List<CatalogTypeListResponseModel>;
                        @foreach (var Item in CatalogTypeList!)
                        {
                            <option value="@Item.CatalogTypeID">@Item.CatalogTypeName</option>
                        }
                    }
                </select>
            </div>
            <label for="stxtCatalogName" class="col-sm-1 col-form-label">Nombre</label>
            <div class="col-sm-5">
                <input type="text" class="form-control" id="stxtCatalogName" maxlength="100" />
            </div>
            <label for="scboStateID" class="col-sm-1 col-form-label">Estado</label>
            <div class="col-sm-2">
                <select class="form-select" id="scboStateID" name="sStateID">
                    <option value="10">Todos</option>
                    <option value="1">Activo</option>
                    <option value="0">Inactivo</option>
                </select>
            </div>
        </div>

        <div class="row pb-2">
            <label for="txtNroInspeccion" class="col-sm-1 col-form-label">Categoria</label>
            <div class="col-sm-2">
                <select class="form-select" id="scboCategoryID">
                    @if (@ViewBag.CategoryList != null)
                    {
                        <option>Todos</option>
                        var CategoryList = ViewBag.CategoryList as List<CategoryListResponseModel>;
                        @foreach (var Item in CategoryList!)
                        {
                            <option value="@Item.CategoryID">@Item.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <label for="txtNroInspeccion" class="col-sm-1 col-form-label">Fabricante</label>
            <div class="col-sm-4">
                <select class="form-select" id="scboManufacturerID">
                    @if (@ViewBag.ManufacturerList != null)
                    {
                        <option>Todos</option>
                        var ManufacturerList = ViewBag.ManufacturerList as List<ManufacturerListResponseModel>;
                        @foreach (var Item in ManufacturerList!)
                        {
                            <option value="@Item.ManufacturerID">@Item.ManufacturerName</option>
                        }
                    }
                </select>
            </div>
            <label for="txtNroInspeccion" class="col-sm-1 col-form-label">Marca</label>
            <div class="col-sm-2">
                <select class="form-select" id="scboBrandID">
                    @if (@ViewBag.BrandList != null)
                    {
                        <option>Todos</option>
                        var BrandList = ViewBag.BrandList as List<BrandListResponseModel>;
                        @foreach (var Item in BrandList!)
                        {
                            <option value="@Item.BrandID">@Item.BrandName</option>
                        }
                    }
                </select>
            </div>
        </div>   
    </form>
</div>
<div class="card-body">
    <div class="table-responsive table-card p-1">
        <table class="table align-middle" id="dtCatalog">
            <thead class="table-light text-muted">
                <tr>
                    <th class="text-center">ID</th>                    
                    <th class="text-center">Tipo </th>        
                    <th class="text-center">Nombre</th>                                
                    <th class="text-center">Variante</th>
                    <th class="text-center">Categoría</th>
                    <th class="text-center">Fabricante</th>                   
                    <th class="text-center">Marca</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Última fecha</th>
                    <th class="text-center">Último usuario </th>        
                    <th class="text-center" colspan="2">Opciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>