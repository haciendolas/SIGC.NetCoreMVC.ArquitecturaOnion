@{
    Layout = null;
}

    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios &nbsp;&nbsp;&nbsp;  <button type="button" class="btn btn-light" name="btnCatalogReturn"><i class="ri-reply-fill align-bottom me-1 fs-13"></i>&nbsp;Retornar&nbsp;</button>&nbsp;&nbsp;</h6>
    <div class="card-body">
        <div class="row pb-2">
            <label class="col-sm-1 col-form-label">Producto<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-11">
                <input type="text" class="form-control" name="CatalogNameLabel" readonly />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-7 p-0">
                <div class="card m-2 border-1">
                    <div class="card-header p-2" style="background:#f3f3f9">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title mb-0">STOCK POR ALMACÉN</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                       <form id="frmCatalogStockCreateUpdate" class="needs-validation" novalidate method="dialog">
                        <div class="row pb-2">
                            <input type="hidden" id="hdCatalogStockID" />
                            <label for="cboWarehouseID" class="col-sm-2 col-form-label">Almacén<i class="ri-asterisk align-middle text-danger"></i></label>
                            <div class="col-sm-10">
                                <select class="form-select" id="cboWarehouseID" name="WarehouseID">                                     
                                        <option value="">Seleccionar</option>                                       
                                </select>
                            </div>                                  
                        </div>
                        <div class="row pb-2">
                            <label for="cboCatalogVariantID" class="col-sm-2 col-form-label">Variante<i class="ri-asterisk align-middle text-danger"></i></label>
                            <div class="col-sm-10">
                                <select class="form-select" id="cboCatalogVariantID" name="CatalogVariantID">
                                    <option value="">Seleccionar</option>
                                </select>
                            </div>
                        </div>
                        <div class="row pb-2">
                            <label for="txtCatalogStockMinimumQuantity" class="col-sm-2 col-form-label">Stock Min</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCatalogStockMinimumQuantity" name="CatalogStockMinimumQuantity" />
                            </div>
                            <label for="txtCatalogStockMaximumQuantity" class="col-sm-2 col-form-label">Stock Max</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCatalogStockMaximumQuantity" name="CatalogStockMaximumQuantity" />
                            </div>
                        </div>                         
                        <div class="row pb-2">
                            <div class="col-sm-12">
                                <div class="text-end">
                                    <button type="button" class="btn btn-light" id="btnCatalogStockNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                                    <button type="button" class="btn btn-primary" id="btnCatalogStockCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                                    <button type="button" class="btn btn-primary" id="btnCatalogStockUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                                </div>
                            </div>
                        </div>
                       </form>
                        <div class="table-responsive table-card pt-3 p-1">
                            <table class="table align-middle" id="dtCatalogStock">
                                <thead class="table-light text-muted">
                                    <tr>
                                    <th class="text-center">Id</th>
                                        <th class="text-center">Establecimiento</th>
                                        <th class="text-center">Almacén</th>
                                        <th class="text-center">Variante</th>                                      
                                        <th class="text-center">Min</th>
                                        <th class="text-center">Max</th>
                                        <th class="text-center">Act</th>                                        
                                        <th class="text-center">Opción</th>
                                    </tr>
                                </thead>
                                <tbody id="catalog-stock-list">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-5 p-0">
                <div class="card m-2 border-1">
                    <div class="card-header p-2" style="background:#f3f3f9">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title mb-0">INVENTARIO POR ESTABLECIMIENTO</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row pb-2">                             
                            <div class="col-sm-6">
                                <div class="form-check form-switch form-switch-md form-switch-secondary">
                                <input type="checkbox" class="form-check-input" checked id="chkCatalogConfigurationIsStockManaged">
                                <label class="form-check-label" for="chkCatalogConfigurationIsStockManaged">Controla Inventario</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch form-switch-md form-switch-secondary">
                                <input type="checkbox" class="form-check-input" checked id="chkCatalogConfigurationIsAffectStock">
                                <label class="form-check-label" for="chkCatalogConfigurationIsAffectStock">Afecto a Stock</label>
                                </div>
                            </div>
                        </div>                       
                        <div class="row pb-2">
                            <div class="col-sm-12">
                                <div class="text-end">
                                    <button type="button" class="btn btn-light" id="btnCatalogConfigurationNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                                    <button type="button" class="btn btn-primary" id="btnCatalogConfigurationCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                                    <button type="button" class="btn btn-primary" id="btnCatalogConfigurationUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive table-card pt-3 p-1">
                            <table class="table align-middle" id="dtCatalogConfiguration">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="text-center">Establecimiento</th>
                                        <th class="text-center">Controla Inventario </th>
                                        <th class="text-center">Afecto a Stock</th>                                     
                                        <th class="text-center">Opción</th>
                                    </tr>
                                </thead>
                                <tbody id="catalog-configuration-list">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div> 
    </div>



