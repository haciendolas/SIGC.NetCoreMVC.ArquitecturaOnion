@using SIGC.Presentation.AspNetCoreMVC.Areas.Security.Models.Constant
@{
    Layout = null;
}
<form id="frmCompanyCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row pb-2">
            <label for="txtCompanyCorporateEmail" class="col-sm-1 col-form-label">Producto<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-11">
                <input type="text" class="form-control" id="txtCompanyCorporateEmail" name="CompanyCorporateEmail" readonly />
            </div>
        </div>
        <div class="row">
            <div class="col-sm-7 p-0">
                <div class="card m-2 border-1">
                    <div class="card-header p-2" style="background:#f3f3f9">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title mb-0">STOCK POR ALMACÉN</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row pb-2">
                            <label for="txtCompanyMobile" class="col-sm-2 col-form-label">Almacén<i class="ri-asterisk align-middle text-danger"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select" id="cboTaxpayerTypeID" name="TaxpayerTypeID">
                                    @if (@ViewBag.TaxpayerTypeList != null)
                                    {
                                        <option value="">Seleccionar</option>
                                        var TaxpayerTypeList = ViewBag.TaxpayerTypeList as List<ConstantListResponseModel>;
                                        @foreach (var Item in TaxpayerTypeList!)
                                        {
                                            <option value="@Item.ConstantID">@Item.ConstantName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <label for="chkStateID" class="col-sm-2 col-form-label">Estado</label>
                            <div class="col-sm-2 pt-2">
                                <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                                    <input type="checkbox" class="form-check-input" checked id="chkStateID">
                                    <label class="form-check-label" for="chkStateID">Activo</label>
                                </div>
                            </div>                          
                        </div>
                        <div class="row pb-2">
                            <label for="txtCompanyMobile" class="col-sm-2 col-form-label">Stock Min</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCompanyMobile" name="CompanyMobile" />
                            </div>
                            <label for="txtCompanyMobile" class="col-sm-2 col-form-label">Stock Max</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCompanyMobile" name="CompanyMobile" />
                            </div>
                        </div>
                        <div class="row pb-2">
                            <label for="txtCompanyMobile" class="col-sm-2 col-form-label">Stock Inicial</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCompanyMobile" name="CompanyMobile" />
                            </div>
                            <label for="txtCompanyMobile" class="col-sm-2 col-form-label">Stock Actual</label>
                            <div class="col-sm-4">
                                <input type="number" class="form-control" id="txtCompanyMobile" name="CompanyMobile" />
                            </div>
                        </div>
                        <div class="row pb-2">
                            <div class="col-sm-12">
                                <div class="text-end">
                                    <button type="button" class="btn btn-light" id="btnCompanyNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                                    <button type="button" class="btn btn-primary" id="btnCompanyCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                                    <button type="button" class="btn btn-primary" id="btnCompanyUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive table-card pt-3 p-1">
                            <table class="table align-middle" id="dtCompany">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="text-center">Almacén</th>
                                        <th class="text-center">Stock Inicial</th>
                                        <th class="text-center">Stock Min</th>
                                        <th class="text-center">Stock Max</th>
                                        <th class="text-center">Stock Act</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center" colspan="2">Opciones</th>
                                    </tr>
                                </thead>
                                <tbody id="details-list">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-5 p-0">
                <div class="card m-2 border-1">
                    <div class="card-header p-2" style="background:#f3f3f9">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="card-title mb-0">CONFIGURACIÓN POR ESTABLECIMIENTO</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row pb-2">                             
                            <div class="col-sm-6">
                                <div class="form-check form-switch form-switch-md form-switch-secondary">
                                    <input type="checkbox" class="form-check-input" checked id="chkStateID">
                                    <label class="form-check-label" for="chkStateID">Controla Inventario</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-check form-switch form-switch-md form-switch-secondary">
                                    <input type="checkbox" class="form-check-input" checked id="chkStateID">
                                    <label class="form-check-label" for="chkStateID">Afecto a Stock</label>
                                </div>
                            </div>
                        </div>
                        <div class="row pb-2">
                            <label for="chkStateID" class="col-sm-2 col-form-label pt-2">Estado</label>
                            <div class="col-sm-5 pt-2">
                                <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                                    <input type="checkbox" class="form-check-input" checked id="chkStateID">
                                    <label class="form-check-label" for="chkStateID">Activo</label>
                                </div>
                            </div>
                        </div>
                        <div class="row pb-2">
                            <div class="col-sm-12">
                                <div class="text-end">
                                    <button type="button" class="btn btn-light" id="btnCompanyNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                                    <button type="button" class="btn btn-primary" id="btnCompanyCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                                    <button type="button" class="btn btn-primary" id="btnCompanyUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive table-card pt-3 p-1">
                            <table class="table align-middle" id="dtCompany">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="text-center">Establecimiento</th>
                                        <th class="text-center">Controla Inventario </th>
                                        <th class="text-center">Afecto a Stock</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center" colspan="2">Opciones</th>
                                    </tr>
                                </thead>
                                <tbody id="details-list">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div> 
    </div>
</form>


