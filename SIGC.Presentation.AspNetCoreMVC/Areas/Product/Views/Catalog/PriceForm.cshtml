@using SIGC.Presentation.AspNetCoreMVC.Areas.Product.Models.PriceType
@using SIGC.Presentation.AspNetCoreMVC.Areas.Security.Models.Constant
@{
    Layout = null;
}
<form id="frmCatalogPriceCreateUpdate" class="needs-validation" novalidate method="dialog">
    <h6 class="pt-2">&nbsp;&nbsp;Todos los campos(<i class="ri-asterisk align-middle text-danger"></i>) son obligatorios</h6>
    <div class="card-body">
        <div class="row pb-2">
            <label class="col-sm-1 col-form-label">Producto<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-11">
                <input type="text" class="form-control" name="CatalogNameLabel" readonly />
            </div>
        </div>
        <div class="row pb-2">
            <input type="hidden" id="hdCatalogPriceID" />
            <label for="cboCatalogPresentationID" class="col-sm-1 col-form-label" style="padding-right:0px">Presentación<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-7">
                <select class="form-select" id="cboCatalogPresentationID" name="CatalogPresentationID">
                    <option value="">Seleccionar</option>
                </select>
            </div>
            <label for="cboPriceTypeID" class="col-sm-2 col-form-label">Tipo Precio<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-2">
                <select class="form-select" id="cboPriceTypeID" name="PriceTypeID">
                    @if (@ViewBag.PriceTypeList != null)
                    {
                        <option value="">Seleccionar</option>
                        var PriceTypeList = ViewBag.PriceTypeList as List<PriceTypeListResponseModel>;
                        @foreach (var Item in PriceTypeList!)
                        {
                            <option value="@Item.PriceTypeID">@Item.PriceTypeName</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row pb-2">
            <label for="cboCurrencyTypeID" class="col-sm-1 col-form-label">Moneda<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-2">
                <select class="form-select" id="cboCurrencyTypeID" name="CurrencyTypeID">
                    @if (@ViewBag.CurrencyTypeList != null)
                    {
                        <option value="">Seleccionar</option>
                        var CurrencyTypeList = ViewBag.CurrencyTypeList as List<ConstantListResponseModel>;
                        @foreach (var Item in CurrencyTypeList!)
                        {
                            <option value="@Item.ConstantID">@Item.ConstantName</option>
                        }
                    }
                </select>
            </div>
            <label for="txtCatalogPriceAmount" class="col-sm-1 col-form-label">Precio<i class="ri-asterisk align-middle text-danger"></i></label>
            <div class="col-sm-2">
                <input type="text" class="form-control" id="txtCatalogPriceAmount" name="CatalogPriceAmount" />
            </div>
            <label for="chkCatalogPriceIsTaxIncluded" class="col-sm-1 col-form-label">&nbsp;</label>
            <div class="col-sm-2 pt-2">
                <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                    <input type="checkbox" class="form-check-input" checked id="chkCatalogPriceIsTaxIncluded">
                    <label class="form-check-label" for="chkCatalogPriceIsTaxIncluded">Incluye Impuesto</label>
                </div>
            </div>
            <label for="chkCatalogPriceStateID" class="col-sm-1 col-form-label">Estado</label>
            <div class="col-sm-2 pt-2">
                <div class="form-check form-switch form-switch-md form-switch-secondary" dir="ltr">
                    <input type="checkbox" class="form-check-input" checked id="chkCatalogPriceStateID">
                    <label class="form-check-label" for="chkCatalogPriceStateID">Activo</label>
                </div>
            </div>
        </div> 
        <div class="row pb-2">
            <div class="col-sm-12 mt-3">
                <div class="text-end">
                    <button type="button" class="btn btn-light" id="btnCatalogPriceNew"><i class="ri-file-text-fill align-bottom me-1 fs-13"></i>&nbsp;Nuevo&nbsp;</button>&nbsp;&nbsp;
                    <button type="button" class="btn btn-primary" id="btnCatalogPriceCreate"><i class="ri-save-3-line align-bottom me-1 fs-13"></i><span>Guardar</span></button>
                    <button type="button" class="btn btn-primary" id="btnCatalogPriceUpdate"><i class="ri-pencil-fill align-bottom me-1 fs-13"></i>Editar&nbsp;</button>
                </div>
            </div>
        </div>
    </div>
</form>
<div class="card-body">
    <div class="table-responsive table-card p-1">
        <table class="table align-middle" id="dtCatalogPrice">
            <thead class="table-light text-muted">
                <tr>
                    <th class="text-center">Establecimiento</th>
                    <th class="text-center">Precio.ID</th>                  
                    <th class="text-center">Presentación</th>
                    <th class="text-center">Tipo Precio</th>
                    <th class="text-center">Moneda</th>                  
                    <th class="text-center">Precio</th>
                    <th class="text-center">Incluye Impuesto</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center" colspan="3">Opciones</th>
                </tr>
            </thead>
            <tbody id="catalog-price-list">
            </tbody>
        </table>
    </div>
</div>